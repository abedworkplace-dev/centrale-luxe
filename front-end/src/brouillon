
.jm-hero {
  --bg-1: #7a3535;
  --bg-2: #4a2028;
  --cream: #f5ece4;
  --dark-pill: rgba(20, 8, 10, 0.55);
  font-family: 'Helvetica Neue', Arial, sans-serif;
  background: url(https://png.pngtree.com/thumb_back/fh260/background/20221201/pngtree-abstract-elegant-banner-web-gold-and-black-shiny-square-round-on-image_1482079.jpg) center/cover no-repeat;
  color: var(--cream);
  min-height: 100vh;
  padding: 24px 40px 40px;
  box-sizing: border-box;
  overflow: hidden;
}

.jm-main {
  padding-top: 200px;
  display: grid;
  grid-template-columns: 1fr 1.2fr 1fr;
  align-items: center;
  gap: 20px;
  position: relative;
}

.jm-left {
  max-width: 320px;
}

.jm-arrows {
  display: flex;
  gap: 10px;
  margin-bottom: 20px;
}

.jm-arrows button {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.3);
  background: transparent;
  color: var(--cream);
  cursor: pointer;
  font-size: 14px;
}

.jm-title {
  font-size: 44px;
  line-height: 1.1;
  font-weight: 600;
  margin: 0 0 18px;
}

.jm-desc {
  font-size: 14px;
  line-height: 1.6;
  opacity: 0.85;
  margin-bottom: 28px;
}

.jm-cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--dark-pill);
  color: var(--cream);
  border: none;
  border-radius: 999px;
  padding: 14px 22px;
  font-size: 13px;
  cursor: pointer;
}

.jm-images {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 420px;
}

.jm-jacket-cream {
  width: 260px;
  height: 320px;
  background: linear-gradient(160deg, #efe6da, #cfc1ae);
  border-radius: 130px 130px 40px 40px;
  box-shadow: 0 30px 60px rgba(0, 0, 0, 0.35);
  z-index: 2;
}

.jm-jacket-red {
  width: 190px;
  height: 220px;
  background: linear-gradient(160deg, #e2483f, #a52a24);
  border-radius: 90px 90px 30px 30px;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
  position: absolute;
  right: -30px;
  bottom: -30px;
  z-index: 3;
}

.jm-tagline {
  position: absolute;
  bottom: -10px;
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
  font-size: 13px;
  opacity: 0.85;
}

.jm-right {
  text-align: right;
}

.jm-price {
  font-size: 30px;
  font-weight: 700;
}

.jm-price-old {
  font-size: 15px;
  text-decoration: line-through;
  opacity: 0.6;
  margin-left: 8px;
}

.jm-size-label {
  font-size: 12px;
  opacity: 0.75;
  margin: 24px 0 10px;
}

.jm-sizes {
  display: flex;
  gap: 10px;
  justify-content: flex-end;
}

.jm-sizes button {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.3);
  background: var(--dark-pill);
  color: var(--cream);
  font-size: 13px;
  cursor: pointer;
}

.jm-sizes button.selected {
  background: var(--cream);
  color: #4a2028;
  font-weight: 700;
}

.jm-social {
  display: flex;
  gap: 16px;
  margin-top: 60px;
  font-size: 15px;
}

@media (max-width: 900px) {
  .jm-main {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .jm-left,
  .jm-right {
    max-width: none;
    text-align: center;
  }

  .jm-sizes {
    justify-content: center;
  }
}



